{
  "name": "email-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/fix-export.mjs",
    "start": "npx serve out",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "emails:art": "node scripts/render-email-art.mjs",
    "emails:previews": "node scripts/shoot-email-previews.mjs",
    "emails:test": "node scripts/test-emails.mjs",
    "emails:build": "node emails/build.mjs",
    "emails": "node emails/build.mjs && node scripts/render-email-art.mjs && node scripts/shoot-email-previews.mjs",
    "test:site": "node scripts/test-site.mjs",
    "test": "node scripts/test-emails.mjs && npm run test:api && node scripts/test-site.mjs",
    "test:api": "node scripts/test-contact-api.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "framer-motion": "12.40.0",
    "lucide-react": "1.17.0",
    "next": "16.3.7",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "20.19.42",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "4.3.0",
    "typescript": "5.9.3"
  }
}
